<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_location" model="ir.ui.view">
        <field name="name">purchase.order.form.location</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="after">
                <field name="location_id" 
                        context="{'show_location_qty': True,'product_id': product_id}"
                        options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>