<?xml version="1.0" encoding="UTF-8"?>
<odoo>    
    <record id="view_crm_assignment_rule_search" model="ir.ui.view">
        <field name="name">crm.assignment.rule.search</field>
        <field name="model">crm.assignment.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="rule_type_id"/>
                <field name="company_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- action -->
    <record id="action_crm_assignment_rule_type" model="ir.actions.act_window">
        <field name="name">Assignment Rule Types</field>
        <field name="res_model">crm.assignment.rule.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_crm_assignment_rule" model="ir.actions.act_window">
        <field name="name">Lead Assignment Rules</field>
        <field name="res_model">crm.assignment.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_assignment_rule_search"/>
    </record>

    <!-- views -->
    <record id="view_crm_assignment_rule_list" model="ir.ui.view">
        <field name="name">crm.assignment.rule.list</field>
        <field name="model">crm.assignment.rule</field>
        <field name="arch" type="xml">
            <list default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type_id"/>
                <field name="company_id" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_crm_assignment_rule_form" model="ir.ui.view">
        <field name="name">crm.assignment.rule.form</field>
        <field name="model">crm.assignment.rule</field>
        <field name="arch" type="xml">
            <form string="Lead Assignment Rule">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Territory Assignment"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Rule Details">
                            <field name="rule_type_id" readonly="id != False"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Settings">
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record> 

    <record id="view_crm_assignment_rule_type_list" model="ir.ui.view">
        <field name="name">crm.assignment.rule.type.list</field>
        <field name="model">crm.assignment.rule.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="lead_field_id"/>
                <field name="skill_type_id"/>
                <field name="processing_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_crm_assignment_rule_type_form" model="ir.ui.view">
        <field name="name">crm.assignment.rule.type.form</field>
        <field name="model">crm.assignment.rule.type</field>
        <field name="arch" type="xml">
            <form string="Assignment Rule Type">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Rule Type Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Configuration">
                            <field name="processing_type"/>
                            <field name="match_model_id" invisible="processing_type != 'description'"/>
                            <field name="lead_field_id" invisible="processing_type == 'existing_customer'"
                                required="processing_type in ('field','score','description')"/>
                            <field name="skill_type_id" invisible="processing_type not in ['field','description']"/>
                        </group>
                        <group string="Settings">
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1"
                                placeholder="Enter description..."/>
                        </page>
                        <page string="Score Ranges"
                            invisible="processing_type != 'score'">
                            <field name="score_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="from_score"/>
                                    <field name="to_score"/>
                                    <field name="skill_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- menus -->
    <menuitem
        id="menu_crm_assignment_rule"
        name="Lead Assignment Rules"
        parent="crm.menu_crm_config_lead"
        action="action_crm_assignment_rule"
        groups="sales_team.group_sale_manager"
        sequence="7"/>

    <menuitem
        id="menu_crm_assignment_rule_type"
        name="Assignment Rule Types"
        parent="crm.menu_crm_config_lead"
        action="action_crm_assignment_rule_type"
        groups="sales_team.group_sale_manager"
        sequence="6"/>
</odoo>