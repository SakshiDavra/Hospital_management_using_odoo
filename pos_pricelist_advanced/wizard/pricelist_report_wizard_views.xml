<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_pricelist_report_wizard" model="ir.ui.view">
        <field name="name">pos.pricelist.report.wizard.form</field>
        <field name="model">pos.pricelist.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Pricelist Sales Report">
                <sheet>
                    <group>
                        <group string="Filters">
                            <field name="pricelist_ids" widget="many2many_tags"/>
                            <field name="group_by"/>
                        </group>
                        <group string="Date">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_print_report"
                        type="object"
                        string="Generate Report"
                        class="btn-primary"/>
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_pricelist_report" model="ir.actions.act_window">
        <field name="name">Pricelist Sales Report</field>
        <field name="res_model">pos.pricelist.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_pos_pricelist_report"
        name="Pricelist Sales Report"
        parent="point_of_sale.menu_point_rep"
        action="action_pos_pricelist_report"
        sequence="40"/>
</odoo>