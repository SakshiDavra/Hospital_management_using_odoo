<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pricelist_report_list" model="ir.ui.view">
        <field name="name">pos.pricelist.report.list</field>
        <field name="model">pos.pricelist.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="pricelist_id"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="order_count"/>
                <field name="qty"/>
                <field name="discount"/>
                <field name="total"/>
            </list>
        </field>
    </record>

    <record id="view_pos_pricelist_report_pivot" model="ir.ui.view">
        <field name="name">pos.pricelist.report.pivot</field>
        <field name="model">pos.pricelist.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="pricelist_id" type="row"/>
                <field name="total" type="measure"/>
                <field name="qty" type="measure"/>
                <field name="order_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_pricelist_report_graph" model="ir.ui.view">
        <field name="name">pos.pricelist.report.graph</field>
        <field name="model">pos.pricelist.report</field>
        <field name="arch" type="xml">
            <graph>
                <field name="pricelist_id"/>
                <field name="total"/>
            </graph>
        </field>
    </record>

    <record id="view_pos_pricelist_report_search" model="ir.ui.view">
        <field name="name">pos.pricelist.report.search</field>
        <field name="model">pos.pricelist.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="pricelist_id"/>
                <field name="config_id"/>
                <field name="session_id"/>
            </search>
        </field>
    </record>

    <record id="action_pos_pricelist_report" model="ir.actions.act_window">
        <field name="name">Pricelist Sales Report</field>
        <field name="res_model">pos.pricelist.report</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <menuitem
        id="menu_pos_pricelist_report"
        name="Pricelist Sales Report"
        parent="point_of_sale.menu_point_rep"
        action="action_pos_pricelist_report"
        sequence="40"/>
</odoo>