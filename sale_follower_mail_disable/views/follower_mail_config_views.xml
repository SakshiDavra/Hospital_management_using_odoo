<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_follower_mail_config_list"
            model="ir.ui.view">

        <field name="name">follower.mail.config.list</field>
        <field name="model">follower.mail.config</field>

        <field name="arch" type="xml">
            <list string="Follower Mail Configuration">

                <field name="model_id"/>
                <field name="stop_auto_follower"/>
                <field name="disable_notification"/>
            </list>
        </field>

    </record>


    <!-- Form View -->
    <record id="view_follower_mail_config_form"
            model="ir.ui.view">

        <field name="name">follower.mail.config.form</field>
        <field name="model">follower.mail.config</field>

        <field name="arch" type="xml">

            <form string="Follower Mail Configuration">
                <field name="active" invisible="1"/>
                <sheet>
                    <widget name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"/>
                    <group>
                        <field name="model_id"/>

                    </group>

                    <!-- Active હોય ત્યારે જ દેખાડો -->
                    <group>
                        
                        <field name="model_name" invisible="1"/>

                        <field name="filter_domain"
                            widget="domain"
                            options="{'model': 'model_name'}"/>

                        <field name="stop_auto_follower"/>

                        <field name="disable_notification"/>

                    </group>

                    <!-- Active હોય ત્યારે notebook દેખાડો -->
                    <notebook invisible="not disable_notification">

                        <page string="Subtype Configuration">

                            <field name="line_ids">

                                <list editable="bottom">

                                    <field name="subtype_id"
                                        domain="[
                                            '|',
                                            ('res_model', '=', model_name),
                                            ('res_model', '=', False)
                                        ]"/>

                                    <field name="partner_ids"
                                        widget="many2many_tags"
                                        domain="[('id', 'in', allowed_partner_ids)]"/>

                                    <field name="active"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Action -->
    <record id="action_follower_mail_config"
            model="ir.actions.act_window">

        <field name="name">Follower Mail Configuration</field>
        <field name="res_model">follower.mail.config</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- Menu -->
    <menuitem
        id="menu_follower_mail_config"
        name="Follower Mail Configuration"
        parent="mail.mail_menu_technical"
        action="action_follower_mail_config"
        sequence="23"
    />

</odoo>