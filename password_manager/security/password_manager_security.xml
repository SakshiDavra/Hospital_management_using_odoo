<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="password_manager_rule_user" model="ir.rule">
        <field name="name">Password User Access</field>
        <field name="model_id" ref="model_password_manager"/>
        <field name="groups" eval="[(4, ref('password_manager.group_password_user'))]"/>
        <field name="domain_force">
        [
            '|',
            ('owner_id', '=', user.id),
            '&amp;',
            ('allowed_user_ids', 'in', [user.id]),
            ('state', '!=', 'draft')
        ]
        </field>
    </record>

    <record id="password_manager_rule_manager" model="ir.rule">
        <field name="name">Password Manager Access</field>
        <field name="model_id" ref="model_password_manager"/>
        <field name="groups" eval="[(4, ref('password_manager.group_password_manager'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <record id="password_manager_portal_rule" model="ir.rule">
        <field name="name">Portal Password Access</field>
        <field name="model_id" ref="model_password_manager"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">['|',('owner_id','=',user.id),'&amp;',('allowed_user_ids','in',[user.id]),('state','!=','draft')]</field>
    </record>

    <record id="password_access_rule_user" model="ir.rule">
        <field name="name">Password Access User</field>
        <field name="model_id" ref="model_password_access"/>
        <field name="groups" eval="[(4, ref('password_manager.group_password_user'))]"/>
        <field name="domain_force">[('password_id.allowed_user_ids', 'in', user.id)]</field>
    </record>

    <record id="password_access_rule_manager" model="ir.rule">

        <field name="name">Password Access Manager</field>
        <field name="model_id" ref="model_password_access"/>
        <field name="groups" eval="[(4, ref('password_manager.group_password_manager'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

</odoo>