<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="password_manager_rule_user" model="ir.rule">
        <field name="name">Password Manager User Access</field>
        <field name="model_id" ref="model_password_manager"/>

        <field name="domain_force">[('allowed_user_ids', 'in', user.id)]</field>

        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="password_manager_rule_admin" model="ir.rule">
        <field name="name">Password Manager Admin Access</field>
        <field name="model_id" ref="model_password_manager"/>

        <field name="domain_force">[(1,'=',1)]</field>

        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="password_manager_portal_rule"
            model="ir.rule">

        <field name="name">
            Portal Password Access
        </field>

        <field name="model_id"
               ref="model_password_manager"/>

        <field name="domain_force">

            [('allowed_user_ids', 'in', user.id)]

        </field>

        <field name="groups"
               eval="[(4, ref('base.group_portal'))]"/>

    </record>

</odoo>