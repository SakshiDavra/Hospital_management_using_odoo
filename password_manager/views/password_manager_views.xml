<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_password_manager_list" model="ir.ui.view">

        <field name="name">password.manager.list</field>

        <field name="model">password.manager</field>

        <field name="arch"
               type="xml">

            <list>

                <field name="name"/>

                <field name="credential_type_id"/>

                <field name="category_ids"
                       widget="many2many_tags"/>

                <field name="username"/>

                <field name="owner_id"/>

                <field name="expiry_date"/>

            </list>

        </field>

    </record>


    <!-- Form View -->
    <record id="view_password_manager_form" model="ir.ui.view">

        <field name="name">password.manager.form</field>

        <field name="model">password.manager</field>

        <field name="arch" type="xml">

            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="credential_type_id"/>
                            <field name="category_ids" widget="many2many_tags"/>
                            <field name="username"/>

                            <label for="password" string="Password"/>
                            <div class="o_row">
                                <field name="password" password="True"/>
                                <button name="action_show_password"
                                        type="object"
                                        class="btn btn-link"
                                        icon="fa-eye"
                                        string="Show"/>
                            </div>

                            <field name="url"/>
                        </group>

                        <group>
                            <field name="owner_id"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Access Rights">

                            <field name="access_ids" nolabel="1">

                                <list editable="bottom">

                                    <field name="user_id"/>

                                    <field name="group_id"/>

                                    <field name="department_id"/>

                                    <field name="can_read"/>

                                    <field name="can_write"/>

                                    <field name="can_delete"/>

                                    <field name="can_share"/>

                                </list>

                            </field>

                        </page>

                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>

                    </notebook>

                </sheet>
            </form>

        </field>

    </record>


    <!-- Action -->
    <record id="action_password_manager"
            model="ir.actions.act_window">

        <field name="name">Passwords</field>

        <field name="res_model">password.manager</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>