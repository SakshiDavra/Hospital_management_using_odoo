<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- List View -->
        <record id="view_password_manager_list" model="ir.ui.view">

            <field name="name">password.manager.list</field>
            <field name="model">password.manager</field>
            <field name="arch" type="xml">
                <list decoration-danger="rotation_overdue">
                    <field name="rotation_overdue" column_invisible="1"/>
                    <field name="name"/>
                    <field name="credential_type_id"/>
                    <field name="category_ids" widget="many2many_tags"/>
                    <field name="username"/>
                    <field name="owner_id"/>
                    <field name="expiry_date"/>
                    <field name="state"
                        widget="badge"
                        decoration-success="state == 'confirmed'"
                        decoration-warning="state == 'draft'"
                        decoration-danger="state == 'expired'"
                        decoration-info="state == 'archived'"/>

                    <!-- <field name="rotation_alert"
                            widget="badge"
                            decoration-danger="rotation_overdue"/> -->

                    <button name="action_show_password"
                            type="object"
                            icon="fa-eye"
                            string="View Password"/>

                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_password_manager_form" model="ir.ui.view">
            <field name="name">password.manager.form</field>
            <field name="model">password.manager</field>
            <field name="arch" type="xml">
                <form>
                    <header>

                        <button name="action_confirm"
                                type="object"
                                string="Confirm"
                                invisible="state != 'draft'"/>

                        <button name="action_set_draft"
                                type="object"
                                string="Set Draft"
                                invisible="state == 'draft'"/>

                        <field name="state"
                            widget="statusbar"
                            statusbar_visible="draft,confirmed,expired"/>

                    </header>

                    <sheet>
                        <field name="rotation_overdue" invisible="1"/>

                        <div class="alert alert-danger"
                            role="alert"
                            invisible="not rotation_overdue">

                            <strong>Warning!</strong>
                            Password rotation date has passed.
                            Please update the password.

                        </div>
                        <group>
                            <group>

                                <field name="active" invisible="1"/>

                                <widget name="web_ribbon"
                                        title="Archived"
                                        bg_color="text-bg-danger"
                                        invisible="active"/>

                        
                                <field name="name"
                                    readonly="state != 'draft'"/>

                                <field name="credential_type_id"
                                    readonly="state != 'draft'"/>

                                <field name="category_ids"
                                    widget="many2many_tags"
                                    readonly="state != 'draft'"/>

                                <field name="username"
                                    readonly="state != 'draft'"/>

                                <field name="password_type"
                                    widget="radio"
                                    invisible="id != False"
                                    readonly="state != 'draft'"/>

                                <label for="password"/>

                                <div>

                                    <!-- Create -->
                                    <div invisible="password_type == 'generate'">

                                        <field name="password"
                                            password="True"
                                            readonly="state != 'draft'"
                                            invisible="id != False"/>

                                    </div>

                                    <div invisible="password_type != 'generate' or id != False">

                                        <button name="action_generate_password_preview"
                                                type="object"
                                                string="Generate Password"
                                                class="btn-secondary"/>

                                    </div>
                                    <!-- Saved -->
                                    <div invisible="id == False"
                                        class="d-flex gap-2">

                                        <button name="action_show_password"
                                                type="object"
                                                class="btn btn-primary"
                                                icon="fa-eye"
                                                string="View Password"/>

                                        <button name="action_edit_password"
                                                type="object"
                                                class="btn btn-secondary"
                                                icon="fa-pencil"
                                                string="Edit Password"/>

                                    </div>

                                </div>

                                <field name="url"
                                        widget="url"
                                        readonly="state != 'draft'"/>

                            </group>

                            <group>

                                <field name="owner_id"
                                    readonly="1"/>

                                <field name="expiry_date"
                                    readonly="state != 'draft'"/>

                                <field name="rotation_days"
                                    readonly="state != 'draft'"/>

                                <field name="rotation_date"
                                        readonly="1"
                                        decoration-danger="rotation_overdue"/>

                            </group>

                        </group>

                        <notebook>

                            <page string="Access Rights">

                                <field name="access_ids"
                                    nolabel="1"
                                    readonly="state != 'draft'">

                                    <list editable="bottom">
                                        <field name="user_id"/>
                                        <field name="group_id"/>
                                        <field name="department_id"/>
                                        <field name="access_until"/>
                                        <field name="can_read"/>
                                        <field name="can_write"/>
                                    </list>

                                </field>

                            </page>

                        </notebook>

                    </sheet>

                    <chatter/>

                </form>
            </field>
        </record>


        <record id="view_password_manager_kanban" model="ir.ui.view">
            <field name="name">password.manager.kanban</field>
            <field name="model">password.manager</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="username"/>
                    <field name="owner_id"/>
                    <field name="credential_type_id"/>
                    <field name="expiry_date"/>
                    <field name="state"/>
                    <field name="rotation_overdue"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card p-2">

                                <div class="d-flex justify-content-between">
                                    <strong>
                                        <field name="name"/>
                                    </strong>

                                    <field name="state"
                                        widget="badge"
                                        decoration-success="state == 'confirmed'"
                                        decoration-warning="state == 'draft'"
                                        decoration-danger="state == 'expired'"/>

                                    
                                </div>

                                <div class="text-muted mt-1">
                                    Type: <field name="credential_type_id"/>
                                </div>

                                <div class="mt-2">
                                    Username: <field name="username"/>
                                </div>
                                <div class="mt-2 d-flex justify-content-between align-items-center">

                                    <button name="action_show_password"
                                            type="object"
                                            class="btn btn-primary btn-sm"
                                            icon="fa-eye"
                                            string="View"/>

                                    <div t-if="record.rotation_overdue.raw_value">
                                        <i t-if="record.rotation_overdue.raw_value"
                                                class="fa fa-exclamation-triangle text-danger"/>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

       <record id="view_password_manager_search" model="ir.ui.view">
            <field name="name">password.manager.search</field>
            <field name="model">password.manager</field>
            <field name="arch" type="xml">
                <search>

                    <field name="name"/>
                    <field name="username"/>
                    <field name="owner_id"/>

                    <filter string="Archived"
                            name="archived"
                            domain="[('active','=',False)]"/>

                    <filter string="Draft"
                            name="draft"
                            domain="[('state','=','draft')]"/>

                    <filter string="Confirmed"
                            name="confirmed"
                            domain="[('state','=','confirmed')]"/>

                    <filter string="Expired"
                            name="expired"
                            domain="[('state','=','expired')]"/>

                    <filter string="My Passwords"
                            name="my_passwords"
                            domain="[('owner_id','=',uid)]"/>

                    <filter string="Rotation Due"
                            name="rotation_due"
                            domain="[('rotation_overdue', '=', True)]"/>
                            
                    <filter string="Potential Duplicates"
                            name="duplicates"
                            domain="[('duplicate_count', '>', 0)]"/>

                    <separator/>

                    <filter string="Owner"
                            name="group_owner"
                            context="{'group_by':'owner_id'}"/>

                    <filter string="Credential Type"
                            name="group_type"
                            context="{'group_by':'credential_type_id'}"/>

                    <filter string="State" 
                            name="group_state"
                            context="{'group_by':'state'}"/>

                    <filter string="Category"
                            name="group_category"
                            context="{'group_by':'category_ids'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_password_manager" model="ir.actions.act_window">
            <field name="name">Passwords</field>
            <field name="res_model">password.manager</field>
            <field name="view_mode">list,form,kanban</field>
        </record>


        <record id="action_password_merge_server"  model="ir.actions.server">

            <field name="name">Merge</field>

            <field name="model_id" ref="model_password_manager"/>

            <field name="binding_model_id" ref="model_password_manager"/>

            <field name="binding_view_types">list</field>

            <field name="state">code</field>

            <field name="code">
                action = {
                    'type': 'ir.actions.act_window',
                    'res_model': 'password.merge.wizard',
                    'view_mode': 'form',
                    'target': 'new',
                    'context': {
                        'active_ids': records.ids,
                    }
                }
            </field>

        </record>

</odoo>