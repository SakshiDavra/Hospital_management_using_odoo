<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- List View -->
        <record id="view_password_manager_list" model="ir.ui.view">

            <field name="name">password.manager.list</field>
            <field name="model">password.manager</field>
            <field name="arch" type="xml">
                <list>

                    <field name="name"/>
                    <field name="credential_type_id"/>
                    <field name="category_ids" widget="many2many_tags"/>
                    <field name="username"/>
                    <field name="owner_id"/>
                    <field name="expiry_date"/>

                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_password_manager_form" model="ir.ui.view">
            <field name="name">password.manager.form</field>
            <field name="model">password.manager</field>
            <field name="arch" type="xml">
                <form>
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_archive"
                            string="Archive"
                            type="object"
                            invisible="state not in ['expired','revoked']"/>

                    <button name="action_set_draft"
                            string="Set Draft"
                            type="object"
                            invisible="state == 'draft'"/>

                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,expired,archived"/>

                </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="credential_type_id"/>
                                <field name="category_ids" widget="many2many_tags"/>
                                <field name="username"/>
                                <label for="password"/>
                                    <div>

                                        <!-- Create -->
                                        <field name="password"
                                            password="True"
                                            invisible="id != False"/>

                                        <!-- Saved -->
                                        <div invisible="id == False"
                                            class="d-flex gap-2">

                                            <button name="action_show_password"
                                                    type="object"
                                                    class="btn btn-primary"
                                                    icon="fa-eye"
                                                    string="View Password"/>

                                            <button name="action_edit_password"
                                                    type="object"
                                                    class="btn btn-secondary"
                                                    icon="fa-pencil"
                                                    string="Edit Password"/>
                                        </div>
                                    </div>
                                <field name="url"/>
                            </group>

                            <group>
                                <field name="owner_id"/>
                                <field name="expiry_date"/>
                            </group>
                        </group>

                        <notebook>

                            <page string="Access Rights">
                                <field name="access_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="user_id"/>
                                        <field name="group_id"/>
                                        <field name="department_id"/>
                                        <field name="access_until"/>
                                        <field name="can_read"/>
                                        <field name="can_write"/>
                                        <field name="can_delete"/>
                                        <field name="can_share"/>
                                    </list>

                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                           
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>


        <record id="view_password_manager_kanban" model="ir.ui.view">
            <field name="name">password.manager.kanban</field>
            <field name="model">password.manager</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="username"/>
                    <field name="owner_id"/>
                    <field name="credential_type_id"/>
                    <field name="expiry_date"/>
                    <field name="state"/>

                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card p-3">

                                <div class="fw-bold fs-5">
                                    <field name="name"/>
                                </div>

                                <div class="text-muted">
                                    <field name="credential_type_id"/>
                                </div>

                                <hr/>

                                <div>
                                    <strong>User:</strong>
                                    <field name="username"/>
                                </div>

                                <div>
                                    <strong>Owner:</strong>
                                    <field name="owner_id"/>
                                </div>

                                <div>
                                    <strong>Expiry:</strong>
                                    <field name="expiry_date"/>
                                </div>

                                <!-- State Badge -->
                                <div class="mt-2">
                                    <field name="state"
                                        widget="badge"
                                        decoration-success="state == 'confirmed'"
                                        decoration-warning="state == 'draft'"
                                        decoration-danger="state == 'expired'"
                                        decoration-info="state == 'archived'"/>
                                </div>

                                <!-- Buttons -->
                                <div class="mt-3 d-flex gap-2">

                                    <button name="action_show_password" type="object" class="btn btn-primary btn-sm">
                                        View Password
                                    </button>

                                    <button name="action_edit_password" type="object" class="btn btn-secondary btn-sm">
                                        Edit Password
                                    </button>

                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

       <record id="view_password_manager_search" model="ir.ui.view">
            <field name="name">password.manager.search</field>
            <field name="model">password.manager</field>
            <field name="arch" type="xml">
                <search>

                    <field name="name"/>
                    <field name="username"/>
                    <field name="owner_id"/>

                    <filter string="Draft"
                            name="draft"
                            domain="[('state','=','draft')]"/>

                    <filter string="Confirmed"
                            name="confirmed"
                            domain="[('state','=','confirmed')]"/>

                    <filter string="Expired"
                            name="expired"
                            domain="[('state','=','expired')]"/>

                    <filter string="My Passwords"
                            name="my_passwords"
                            domain="[('owner_id','=',uid)]"/>

                    <separator/>

                    <filter string="Owner"
                            name="group_owner"
                            context="{'group_by':'owner_id'}"/>

                    <filter string="Credential Type"
                            name="group_type"
                            context="{'group_by':'credential_type_id'}"/>

                    <filter string="State"
                            name="group_state"
                            context="{'group_by':'state'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_password_manager" model="ir.actions.act_window">
            <field name="name">Passwords</field>
            <field name="res_model">password.manager</field>
            <field name="view_mode">list,form,kanban</field>
        </record>

</odoo>