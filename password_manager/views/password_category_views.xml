<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_password_category_list" model="ir.ui.view">
        <field name="name">password.category.list</field>
        <field name="model">password.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>

    </record>


    <record id="view_password_category_form" model="ir.ui.view">
        <field name="name">password.category.form</field>
        <field name="model">password.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="category_password" password="True"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>

    </record>

    <!-- Action -->
    <record id="action_password_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">password.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>