<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_password_vault_tree" model="ir.ui.view">
        <field name="name">password.vault.tree</field>
        <field name="model">password.vault</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <record id="view_password_vault_form" model="ir.ui.view">
        <field name="name">password.vault.form</field>
        <field name="model">password.vault</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="owner_id"/>
                        <field name="description"/>
                    </group>

                    <notebook>

                        <page string="Passwords">

                            <field name="password_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="credential_type_id"/>
                                    <field name="owner_id"/>
                                    <field name="state"/>
                                </list>
                            </field>

                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_password_vault" model="ir.actions.act_window">
        <field name="name">Vaults</field>
        <field name="res_model">password.vault</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>