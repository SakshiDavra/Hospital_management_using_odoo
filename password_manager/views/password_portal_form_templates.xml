<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<template id="portal_password_form" inherit_id="portal.portal_sidebar" primary="True">
    <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
        <div class="row">
            <!-- LEFT SIDEBAR -->
            <t t-call="portal.portal_record_sidebar">
                <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                <t t-set="entries">
                    <div class="d-flex flex-column gap-2">
                        <button type="button" class="btn btn-primary portal-view-password" t-att-data-password-id="password.id">
                            <i class="fa fa-eye me-1"/>
                            View Password
                        </button>
                        <t t-if="can_write and password.state == 'draft'">
                            <a t-att-href="'/my/password/%s/edit_detail' % password.id"
                            class="btn btn-secondary">
                                <i class="fa fa-pencil me-1"/>
                                Edit Detail
                            </a>
                        </t>

                        <t t-if="can_write">
                            <button type="button"
                                    class="btn btn-secondary portal-edit-password"
                                    t-att-data-password-id="password.id">
                                <i class="fa fa-key me-1"/>
                                Edit Password
                            </button>
                        </t>
                    </div>
                    <hr/>
                    <p>
                        <strong>Owner</strong><br/>
                        <t t-esc="password.owner_id.name"/>
                    </p>
                    <p>
                        <strong>Credential Type</strong><br/>
                        <t t-esc="password.credential_type_id.name"/>
                    </p>
                </t>
            </t>

            <!-- RIGHT CONTENT -->
            <div class="col-12 col-lg-8 col-xxl-9 o_portal_content">
                <div class="d-flex justify-content-between">
                    <h2>
                        Password - <t t-esc="password.name"/>
                    </h2>
                    <div>
                        <span t-if="password.state == 'confirmed'" class="badge bg-success">Confirmed</span>
                        <t t-if="password.owner_id.id == request.env.user.id">
                            <a t-if="password.state == 'draft'" t-att-href="'/my/password/%s/confirm' % password.id"
                            class="btn btn-success btn-sm">Confirm</a>
                        </t>
                        <span t-if="password.state == 'draft'" class="badge bg-warning text-dark">Draft</span>
                        <span t-if="password.state == 'expired'" class="badge bg-danger">Expired</span>
                    </div>
                </div>

                <hr/>

                <div class="row">
                    <div class="col-md-6">
                        <h5>Password Info</h5>
                        <hr/>
                        <p>
                            <strong>Username:</strong>
                            <t t-esc="password.username"/>
                        </p>
                        <p>
                            <strong>Owner:</strong>
                            <t t-esc="password.owner_id.name"/>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <h5>Schedule</h5>
                        <p>
                            <strong>Rotation Days:</strong>
                            <t t-esc="password.rotation_days"/>
                        </p>
                        <p>
                            <strong>Rotation Date:</strong>
                            <t t-esc="password.rotation_date"/>
                        </p>
                        <hr/>
                        <p>
                            <strong>Expiry Date:</strong>
                            <t t-esc="password.expiry_date"/>
                        </p>
                    </div>
                </div>
                <hr/>
                <h5>Categories</h5>
                <t t-foreach="password.category_ids" t-as="category">
                    <span class="badge bg-secondary me-1">
                        <t t-esc="category.name"/>
                    </span>
                </t>
            </div>
            <!-- Reusable Modal Component -->
            <t t-call="password_manager.portal_password_modals"/>
        </div>
    </xpath>
</template>

<template id="portal_create_password" name="Create Password">
    <t t-call="portal.portal_layout">
        <div class="container my-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2>
                        <t t-if="edit_mode">Edit Password</t>
                        <t t-else="">Create Password</t>
                    </h2>
                    <small class="text-muted">Create a new credential</small>
                </div>
            </div>
            <t t-if="error">
                <div class="alert alert-danger">
                    <t t-esc="error"/>
                </div>
            </t>

            <form t-att-action="'/my/password/%s/update_detail' % password.id if edit_mode else '/my/password/create'" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <!-- LEFT COLUMN -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label>Name *</label>
                                    <input type="text" name="name" required="required"
                                     t-att-value="password.name if edit_mode else ''" class="form-control"/>
                                </div>

                                <div class="mb-3">
                                    <label>Credential Type</label>
                                    <select name="credential_type_id" class="form-select">
                                        <option value="">Select Credential Type</option>
                                        <t t-foreach="credential_types" t-as="ctype">
                                            <option t-att-value="ctype.id"
                                                t-att-selected="edit_mode and ctype.id == password.credential_type_id.id">
                                                <t t-esc="ctype.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label>Username</label>
                                    <input type="text" name="username"
                                     t-att-value="password.username if edit_mode else ''" class="form-control"/>
                                </div>

                                <div class="mb-3">
                                    <label class="fw-bold mb-2">Categories</label>
                                    <div class="border rounded p-3">
                                        <t t-foreach="categories" t-as="category">
                                            <div class="form-check">
                                                <input  class="form-check-input" type="checkbox" name="category_ids"
                                                    t-att-id="'cat_%s' % category.id" t-att-value="category.id"
                                                    t-att-checked=" edit_mode and category in password.category_ids"/>
                                                <label class="form-check-label" t-att-for="'cat_%s' % category.id">
                                                    <t t-esc="category.name"/>
                                                </label>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- RIGHT COLUMN -->
                            <div class="col-md-6">
                                <t t-if="not edit_mode">

                                    <div class="mb-3">
                                        <label class="fw-bold">Password Type</label>

                                        <div class="form-check">
                                            <input class="form-check-input"
                                                type="radio"
                                                name="password_type"
                                                id="manual_password_type"
                                                value="manual"
                                                checked="checked"/>

                                            <label class="form-check-label"
                                                for="manual_password_type">
                                                Manual
                                            </label>
                                        </div>

                                        <div class="form-check">
                                            <input class="form-check-input"
                                                type="radio"
                                                name="password_type"
                                                id="generate_password_type"
                                                value="generate"/>

                                            <label class="form-check-label"
                                                for="generate_password_type">
                                                Generate
                                            </label>
                                        </div>
                                    </div>

                                    <div class="mb-3" id="manual_password_div">
                                        <label>Password</label>
                                        <input type="password"
                                            id="password"
                                            name="password"
                                            class="form-control"/>
                                    </div>

                                    <div class="mb-3 d-none" id="generate_password_div">
                                        <label>Generated Password</label>

                                        <div class="input-group">
                                            <input type="text"
                                                id="generated_password"
                                                readonly="readonly"
                                                class="form-control"/>

                                            <button type="button"
                                                    id="generate_password_btn"
                                                    class="btn btn-primary">
                                                Generate Password
                                            </button>
                                        </div>
                                    </div>

                                </t>

                                <div class="mb-3">
                                    <label>URL</label>
                                    <input type="text" name="url" t-att-value="password.url if edit_mode else ''" class="form-control"/>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label>Expiry Date</label>
                                            <input type="date" name="expiry_date" t-att-value="password.expiry_date
                                                    if edit_mode
                                                    else ''"
                                                class="form-control"/>

                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label>Rotation Days</label>

                                            <input type="number"
                                                    name="rotation_days"
                                                    t-att-value="password.rotation_days if edit_mode else 0"
                                                    min="0"
                                                    class="form-control"/>
                                        </div>
                                    </div>

                                    <div class="col-12 mt-2">
                                        <label>Next Rotation Date</label>
                                        <input type="text" id="rotation_date_preview" class="form-control" readonly="readonly"
                                            t-att-value="password.rotation_date
                                                if edit_mode and password.rotation_date
                                                else ''"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="card-footer text-end">
                        <a href="/my/passwords" class="btn btn-secondary">Cancel</a>
                        <button type="submit"  class="btn btn-primary">
                            <t t-if="edit_mode">Update Password</t>

                            <t t-else="">Create Password</t>
                        </button>
                    </div>
                    </div>
            </form>
        </div>
    </t>

</template>
</odoo>
