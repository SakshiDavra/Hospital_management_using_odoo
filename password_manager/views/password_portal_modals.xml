<odoo>

    <template id="portal_password_modals">
        <div id="verifyPasswordModal" class="portal-modal"
             style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;">
            <div style="width:500px;background:white;margin:120px auto;padding:20px;border-radius:10px;">
                <h4>Verify Password</h4>
                <label>Enter Category Password</label>
                <input type="password" id="portal_verify_password" class="form-control"/>
                <input type="hidden" id="selected_password_id"/>
                <br/>
                <button type="button" class="btn btn-primary" id="confirmPasswordBtn">Confirm Password</button>

                <button type="button" class="btn btn-secondary close-modal">Close</button>
            </div>
        </div>

        <!-- SHOW PASSWORD MODAL -->
        <div id="showPasswordModal" class="portal-modal"
             style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;">
            <div style="width:500px;background:white;margin:120px auto;padding:20px;border-radius:10px;">
                <h4>Password</h4>
                <p>
                    <strong>Password :</strong>
                    <span id="portal_real_password"></span>
                </p>
                <button type="button" class="btn btn-secondary close-modal">Close</button>
            </div>
        </div>

        <div id="editPasswordModal"
            class="portal-modal"
            style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;
                    background:rgba(0,0,0,0.5);z-index:9999;">

            <div style="width:500px;background:white;margin:120px auto;
                        padding:20px;border-radius:10px;">

                <h4>Edit Password</h4>

                <input type="hidden" id="edit_password_id"/>
                <div class="mb-3">
                    <label>Current Password</label>

                    <input type="password"
                        id="current_password"
                        class="form-control"/>
                </div>
                <div class="mb-3">
                    <label>New Password</label>

                    <input type="password"
                        id="new_password"
                        class="form-control"/>
                </div>

                <div class="mb-3">
                    <button type="button"
                            id="generate_password_btn"
                            class="btn btn-secondary">
                        Generate Password
                    </button>
                </div>

                <button type="button"
                        id="updatePasswordBtn"
                        class="btn btn-primary">
                    Update
                </button>

                <button type="button"
                        class="btn btn-secondary close-modal">
                    Cancel
                </button>

            </div>
        </div>
        

    </template>
</odoo>