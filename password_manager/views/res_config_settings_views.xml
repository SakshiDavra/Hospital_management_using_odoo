<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_password_manager" model="ir.ui.view">
        <field name="name">res.config.settings.password.manager</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Password Manager" name="password_manager">
                    <block title="Password Policy">
                        <setting string="Password Length">
                            <field name="password_length"/>
                        </setting>

                        <setting string="Require Uppercase">
                            <field name="require_uppercase"/>
                        </setting>

                        <setting string="Require Lowercase">
                            <field name="require_lowercase"/>
                        </setting>

                        <setting string="Require Numbers">
                            <field name="require_numbers"/>
                        </setting>

                        <setting string="Require Special Characters">
                            <field name="require_special"/>
                        </setting>
                        <setting string="Reminder Before Expiry (Days)">
                            <field name="password_reminder_days"/>
                        </setting>
                        <setting string="Rotation Reminder Before (Days)">
                            <field name="rotation_reminder_days"/>
                        </setting>
                        <setting string="Encryption Key">
                            <field name="encryption_key"/>
                        </setting>
                        <setting string="Password View Timeout (Seconds)">
                            <field name="password_view_timeout"/>
                        </setting>

                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>