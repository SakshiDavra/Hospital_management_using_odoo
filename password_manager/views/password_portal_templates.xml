<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_breadcrumbs_passwords" inherit_id="portal.portal_breadcrumbs" name="Passwords Breadcrumb">

        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'passwords'" class="breadcrumb-item active">Passwords</li>

            <t t-if="page_name == 'password'">
                <li class="breadcrumb-item">
                    <a href="/my/passwords">Passwords</a>
                </li>
                <li class="breadcrumb-item active">
                    <t t-esc="password.name"/>
                </li>
            </t>

            <t t-if="page_name == 'password_create'">
                <li class="breadcrumb-item">
                    <a href="/my/passwords">Passwords</a>
                </li>
                <li class="breadcrumb-item active">
                    Create Password
                </li>
            </t>

            <!-- Edit -->
            <t t-if="page_name == 'password_edit'">
                <li class="breadcrumb-item">
                    <a href="/my/passwords">Passwords</a>
                </li>
                <li class="breadcrumb-item">
                    <a t-att-href="'/my/password/%s' % password.id">
                        <t t-esc="password.name"/>
                    </a>
                </li>
                <li class="breadcrumb-item active">
                    Edit Password
                </li>
            </t>

        </xpath>
    </template>

    <template id="portal_my_home_passwords" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']"  position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">Passwords</t>
                <t t-set="text">View your saved passwords</t>
                <t t-set="url" t-value="'/my/passwords'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_passwords" name="My Passwords">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">My Passwords</h2>
                    <a href="/my/password/new" class="btn btn-primary">
                        <i class="fa fa-plus me-1"/>Create Password
                    </a>
                </div>
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Credential Type</th>
                            <th>Categories</th>
                            <th>Username</th>
                            <th>Owner</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="passwords" t-as="password">
                            <tr>
                                <td>
                                    <a t-att-href="'/my/password/%s' % password.id">
                                        <t t-esc="password.name"/>
                                    </a>
                                </td>
                                <td>
                                    <t t-esc="password.credential_type_id.name"/>
                                </td>
                                <td>
                                    <t t-foreach="password.category_ids" t-as="category">
                                        <span class="badge bg-primary me-1">
                                            <t t-esc="category.name"/>
                                        </span>
                                    </t>
                                </td>
                                <td>
                                    <t t-esc="password.username"/>
                                </td>
                                <td>
                                    <t t-esc="password.owner_id.name"/>
                                </td>
                                <td>
                                    <t t-esc="password.expiry_date"/>
                                </td>
                                <td>
                                    <t t-esc="password.state"/>
                                    <!-- <t t-if="password.duplicate_count">
                                        <span class="badge bg-danger ms-1">Duplicate</span>
                                    </t> -->
                                </td>
                                <td>
                                    <button type="button" class="btn btn-primary portal-view-password"
                                        t-att-data-password-id="password.id">
                                        <i class="fa fa-eye me-1"/>View Password</button>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <!-- Reusable Modal Component -->
            <t t-call="password_manager.portal_password_modals"/>
            <script>window.passwordTimeout = <t t-esc="timeout_seconds"/>;</script>
        </t>
    </template>
</odoo>