<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_password_credential_type_list" model="ir.ui.view">
        <field name="name">password.credential.type.list</field>
        <field name="model">password.credential.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_password_credential_type_form" model="ir.ui.view">
        <field name="name">password.credential.type.form</field>
        <field name="model">password.credential.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_password_credential_type" model="ir.actions.act_window">
        <field name="name">Credential Types</field>
        <field name="res_model">password.credential.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>