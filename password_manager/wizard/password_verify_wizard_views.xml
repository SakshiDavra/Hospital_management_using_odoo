<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_password_verify_wizard_form" model="ir.ui.view">
        <field name="name">password.verify.wizard.form</field>
        <field name="model">password.verify.wizard</field>
        <field name="arch" type="xml">
            <form string="Access Control">
                <sheet>
                    <div>
                        <h3>
                            <strong>Let's first confirm it's you. Enter your current password:</strong>
                        </h3>
                        <div>
                            <field name="login_password" password="True"
                                   class="o_field_highlight col-10 col-md-6 px-0" placeholder="Enter your password"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_verify"
                            string="Confirm Password"
                            type="object"
                            class="btn btn-primary"/>
                    <button string="Discard"
                            special="cancel"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>