<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_password_merge_wizard_form"
            model="ir.ui.view">

        <field name="name">password.merge.wizard.form</field>
        <field name="model">password.merge.wizard</field>

        <field name="arch" type="xml">

            <form string="Merge Passwords">

                <sheet>

                    <separator string="Merge The Following Passwords"/>

                    <p class="text-muted">
                        Selected passwords will be merged together.
                        You can remove passwords from this list before merging.
                    </p>

                    <group>
                        <field name="destination_password_id"
                            domain="[('id', 'in', password_ids)]"/>
                    </group>

                    <field name="password_ids" nolabel="1">

                        <list editable="bottom">

                            <field name="name"/>
                            <field name="credential_type_id"/>
                            <field name="username"/>
                            <field name="owner_id"/>
                            <field name="expiry_date"/>
                            <field name="state"/>

                        </list>

                    </field>

                </sheet>

                <footer>

                    <button name="action_merge"
                            string="Merge Passwords"
                            type="object"
                            class="btn-primary"/>

                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>