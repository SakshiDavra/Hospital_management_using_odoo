<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_password_view_wizard_form" model="ir.ui.view">
        <field name="name">password.view.wizard.form</field>
        <field name="model">password.view.wizard</field>
        <field name="arch" type="xml">
            <form string="Password">
                <div class="alert alert-warning" role="alert">
                    🔒 This password will automatically close.
                </div>
                <group>
                    <field name="timeout_seconds"
                           readonly="1"/>
                    <field name="password"
                           readonly="1"/>
                </group>
                <footer>
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>