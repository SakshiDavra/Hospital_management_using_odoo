<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="purchase_order_form_ocr" model="ir.ui.view">
        <field name="name">purchase.order.form.ocr</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='purchase_file_uploader']" position="replace">
                <widget name="invoice_uploader" invisible="state != 'purchase'"/>
            </xpath>
        </field>
    </record>

</odoo>
