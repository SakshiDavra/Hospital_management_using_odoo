<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_bill_validation_wizard_form" model="ir.ui.view">
        <field name="name">purchase.bill.validation.wizard.form</field>
        <field name="model">purchase.bill.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="Vendor Bill Validation">

                <div class="alert alert-warning" role="alert">
                    PO Qty, Received Qty and Invoice Qty do not match.
                    Please review before creating the Vendor Bill.
                </div>

                <field name="purchase_id" invisible="1"/>

                <field name="line_ids">
                    <list create="0" delete="0">
                        <field name="display_name" string="Product"/>
                        <field name="po_qty"/>
                        <field name="receipt_qty"/>
                        <field name="invoice_qty"/>
                    </list>
                </field>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm &amp; Create Bill"
                            class="btn-primary"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>