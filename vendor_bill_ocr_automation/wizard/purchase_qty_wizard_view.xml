<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_purchase_qty_wizard_form" model="ir.ui.view">
        <field name="name">purchase.qty.wizard.form</field>
        <field name="model">purchase.qty.wizard</field>
        <field name="arch" type="xml">
            <form string="Quantity Mismatch Confirmation">

    <sheet>

        <div class="alert alert-warning" role="alert">
            <strong>Warning!</strong><br/>
            The uploaded invoice contains quantity differences and/or new products.<br/>
            New products will be added to the Purchase Order only after you click <b>Update PO Quantity</b>.
        </div>

        <field name="purchase_id" invisible="1"/>

        <field name="line_ids" readonly="1">
            <list create="0" delete="0" edit="0">
            
                <field name="display_name"/>
                <field name="action_name"/>
                <field name="po_qty"/>
                <field name="invoice_qty"/>
            </list>
        </field>

    </sheet>

    <footer>
        <button
            name="action_confirm_update"
            string="Update PO Quantity"
            type="object"
            class="btn-primary"/>

        <button
            string="Cancel"
            special="cancel"
            class="btn-secondary"/>
    </footer>

</form>
        </field>
    </record>

</odoo>