<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sale_revision" model="ir.ui.view">
        <field name="name">res.config.settings.sale.revision</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">

                <block title="Sale Order Revision"
                    name="sale_revision_setting_container">

                    <setting string="Enable Sale Revision"
                            help="Enable revision creation for sales orders">
                        <field name="enable_sale_revision"/>
                    </setting>

                    <setting string="Revision Prefix"
                            invisible="not enable_sale_revision">
                        <field name="revision_prefix"
                            placeholder="Example: R, REV"/>
                    </setting>

                    <setting string="Revision Separator"
                            invisible="not enable_sale_revision">
                        <field name="revision_separator"/>
                    </setting>

                </block>

            </xpath>
        </field>
    </record>
</odoo>