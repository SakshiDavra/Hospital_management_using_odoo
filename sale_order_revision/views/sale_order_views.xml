<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_revision_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.revision.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">state != 'sent' or is_revision</attribute>
            </xpath>

            <xpath expr="//button[@name='action_confirm' and not(@id='action_confirm')]"
                position="attributes">
                <attribute name="invisible">state != 'draft' or is_revision</attribute>
            </xpath>

            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_merge_revision"
                        string="Merge Revision"
                        type="object"
                        class="btn-primary"
                        invisible="not is_revision or state == 'cancel'"
                        confirm="Are you sure you want to merge this revision into the main order?&#10;⚠ This action will automatically cancel all other revisions of this order."/>
            </xpath>

            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_create_revision"
                        string="Create Revision"
                        type="object"
                        class="btn-secondary"
                        invisible="not show_revision_button"/>
            </xpath>

            <xpath expr="//div[@name='button_box']/button[@name='action_view_invoice']"
                   position="after">

                <button name="action_view_revisions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-files-o"
                        invisible="is_revision or revision_count == 0">

                    <field name="revision_count"
                        widget="statinfo"
                        string="Revisions"/>
                </button>

            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="revision_count" invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>