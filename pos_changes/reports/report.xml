<odoo>

    <record id="paperformat_pos_receipt" model="report.paperformat">
        <field name="name">POS Receipt</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>

        <field name="page_width">90</field>

        <field name="page_height">0</field>

        <field name="orientation">Portrait</field>

        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>

        <field name="dpi">90</field>
    </record>

    <record id="action_pos_order_receipt_backend" model="ir.actions.report">
        <field name="name">POS Receipt</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_changes.pos_order_receipt_backend</field>
        <field name="report_file">pos_changes.pos_order_receipt_backend</field>

        <field name="paperformat_id" ref="pos_changes.paperformat_pos_receipt"/>
    </record>

</odoo>