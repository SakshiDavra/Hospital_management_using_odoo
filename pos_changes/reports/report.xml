<odoo>

    <!-- Paper Format (NEW) -->
    <record id="paperformat_pos_receipt" model="report.paperformat">
        <field name="name">POS Receipt</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>

        <!-- width (80mm receipt) -->
        <field name="page_width">80</field>

        <!-- height auto -->
        <field name="page_height">200</field>

        <field name="orientation">Portrait</field>

        <!-- margins -->
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>

        <field name="dpi">90</field>
    </record>


    <!--  YOUR REPORT (UPDATED) -->
    <record id="action_pos_order_receipt_backend" model="ir.actions.report">
        <field name="name">POS Receipt</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_changes.pos_order_receipt_backend</field>
        <field name="report_file">pos_changes.pos_order_receipt_backend</field>

        <!-- IMPORTANT LINE -->
        <field name="paperformat_id" ref="pos_changes.paperformat_pos_receipt"/>
    </record>

</odoo>