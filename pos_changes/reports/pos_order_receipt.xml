<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="pos_order_receipt_backend">
        <t t-call="web.html_container"> 
        <head>
            <link rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
        </head>
            <t t-foreach="docs" t-as="order">
                <t t-call="web.basic_layout">
                    <t t-set="lines" t-value="order.get_pos_ui_lines()"/>
                        <div class="page" style="margin-bottom:10px;"> 
        
                            <div style=" font-family:monospace; color:#000;">

                                <!-- HEADER -->
                                <div style="text-align:center; margin-bottom:10px;">

                                    <img t-if="order.company_id.id"
                                    t-att-src="'/web/image/res.company/%s/logo' % order.company_id.id"
                                    style="max-height:55px; margin-top:3px; margin-bottom:6px;"/>

                                    <div style="font-size:10px;">
                                        Tax Invoice <t t-esc="order.pos_reference"/> INVOICE
                                    </div>

                                    <div style="font-size:10px; margin-top:3px;">
                                        <t t-esc="context_timestamp(order.date_order).strftime('%d/%m/%Y, %I:%M %p')"/>
                                    </div>

                                    <div style="font-size:10px;">
                                        Served by: <t t-esc="order.user_id.name.split(' ')[0]"/>
                                    </div>

                                    <!-- CUSTOMER INFO -->
                                    <t t-if="order.partner_id">

                                        <!-- NAME (Company + Contact like POS) -->
                                        <div style="margin-top:6px; font-size:10px; line-height:1.1;">

                                            <t t-if="order.partner_id.parent_id">
                                                <t t-esc="order.partner_id.parent_id.name + ', '"/>
                                            </t>
                                            <t t-esc="order.partner_id.name"/>

                                        </div>

                                        <!-- ADDRESS (POS style single clean line) -->
                                        <div style="font-size:10px; margin-top:2px; line-height:1.1;">

                                            <t t-set="addr"
                                                t-value="' '.join(filter(None, [
                                                    order.partner_id.street,
                                                    order.partner_id.street2,
                                                    order.partner_id.city,
                                                    (order.partner_id.state_id.name if order.partner_id.state_id else ''),
                                                    order.partner_id.zip,
                                                    (order.partner_id.country_id.name if order.partner_id.country_id else '')
                                                ]))"/>

                                            <t t-esc="addr"/>

                                        </div>

                                        <!-- VAT -->
                                        <t t-if="order.partner_id.vat">
                                            <div style="font-size:10px; margin-top:2px; line-height:1.1;">
                                                <t t-esc="order.partner_id.vat"/>
                                            </div>
                                        </t>

                                        <!-- PHONE -->
                                        <t t-if="order.partner_id.phone">
                                            <div style="font-size:10px; margin-top:2px; line-height:1.1;">
                                                Phone: <t t-esc="order.partner_id.phone"/>
                                            </div>
                                        </t>

                                    </t>
                                </div>

                                <div style="border-top:1px dashed #ffffff; margin:8px 0;"></div>

                                <!-- PRODUCTS -->
                                <t t-foreach="lines" t-as="line">
                                    <t t-set="is_child" t-value="line['is_child']"/>

                                    <div style="margin-bottom:6px; font-family:monospace;">
                                        <table style="width:100%; border-collapse: collapse;">
                                            <tr>
                                                <!-- ================= QTY COLUMN ================= -->
                                                <!-- Main product mate standard QTY, Child mate empty space jethi indentation male -->
                                                <td style="width:30px; font-weight:700; vertical-align:top;">
                                                    <t t-if="not is_child">
                                                        <t t-set="qty" t-value="line['qty']"/>
                                                        <t t-esc="int(qty) if qty == int(qty) else qty"/>
                                                    </t>
                                                </td>
                                                <!-- ================= NAME & DETAILS COLUMN ================= -->
                                                <td t-att-colspan="2 if is_child else 1" style="width:auto; vertical-align:top; padding:0;">
                                                    
                                                    <!-- CHILD PRODUCT LAYOUT -->
                                                    <t t-if="is_child">
                                                        <table style="width:100%; border-spacing:0; border-collapse:collapse; margin-top:-1px;">
                                                            <tr>
                                                     
                                                                <td style="width:30px; font-weight:700; vertical-align:top; font-style:italic; padding-left:5px;">
                                                                    <t t-set="qty" t-value="line['qty']"/>
                                                                    <t t-esc="int(qty) if qty == int(qty) else qty"/>
                                                                </td>
                                                             
                                                                <td style="vertical-align:top; font-style:italic; word-break:break-word; padding-left:2px;">
                                                                    <t t-esc="line['name']"/>
                                                                </td>
                                                            </tr>
                                                          
                                                            <tr>
                                                                <td/>
                                                                <td style="font-size:9.5px; color:#666; padding-left:2px; padding-bottom:4px;">
                                                                    $ <t t-esc="'{:,.2f}'.format(line['unit_price'])"/> / Units
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </t>

                                                    <t t-if="not is_child">
                                                        <div style="padding-left:8px;">
                                                            <div style="font-size:12px; line-height:1.2; word-break:break-word;">
                                                                <t t-esc="line['name']"/>
                                                            </div>
                                                            <div style="font-size:9.5px; margin-top:2px;">
                                                                $ <t t-esc="'{:,.2f}'.format(line['unit_price'])"/> / Units
                                                            </div>
                                                        </div>
                                                    </t>
                                                </td>

                                                <t t-if="not is_child">
                                                    <td style="width:80px; text-align:right; vertical-align:top;">
                                                        $ <t t-esc="'{:,.2f}'.format(line['price'])"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </table>
                                    </div>
                                </t>
                                
                                <div style="border-top:1px dashed #ffffff; margin:8px 0;"></div>
                            
                                <!-- TOTAL -->
                                <!-- SUBTOTAL + TAX + TOTAL -->
                                <table style="width:100%; font-size:13px; margin-top:6px;">

                                    <!-- SUBTOTAL -->
                                    <t t-if="order.amount_tax &gt; 0">
                                        <tr>
                                            <td>Subtotal</td>
                                            <td style="text-align:right;">
                                                $ <t t-esc="'{:,.2f}'.format(order.amount_total - order.amount_tax)"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <!-- TAX -->
                                    <t t-set="taxes" t-value="order.get_tax_breakup()"/>

                                        <t t-foreach="taxes" t-as="tax">
                                            <tr>
                                                <td>
                                                    <t t-esc="tax['name']"/> on $
                                                    <t t-esc="'{:,.2f}'.format(tax['base'])"/>
                                                </td>
                                                <td style="text-align:right;">
                                                    $ <t t-esc="'{:,.2f}'.format(tax['amount'])"/>
                                                </td>
                                            </tr>
                                        </t>

                                    <!-- TOTAL -->
                                    <tr>
                                        <td style="font-weight:700; padding-top:4px;">Total</td>
                                        <td style="text-align:right; font-weight:700; padding-top:4px;">
                                            $ <t t-esc="'{:,.2f}'.format(order.amount_total)"/>
                                        </td>
                                    </tr>

                                </table>

                                <!-- PAYMENTS -->

                                <t t-set="payments" t-value="order.payment_ids.filtered(lambda p: not p.is_change)"/>

                                <!-- NORMAL PAYMENTS -->
                                <t t-foreach="payments" t-as="p">
                                    <table style="width:100%;">
                                        <tr>
                                            <td><t t-esc="p.payment_method_id.name"/></td>
                                            <td style="text-align:right;">
                                                $ <t t-esc="'{:,.2f}'.format(p.amount)"/>
                                            </td>
                                        </tr>
                                    </table>
                                </t>

                                <!-- CHANGE -->
                                <t t-set="change" t-value="sum(order.payment_ids.filtered(lambda p: p.is_change).mapped('amount'))"/>

                                <t t-if="change">
                                    <table style="width:100%;">
                                        <tr>
                                            <td>Change</td>
                                            <td style="text-align:right;">
                                                $ <t t-esc="'{:,.2f}'.format(change)"/>
                                            </td>
                                        </tr>
                                    </table>
                                </t>

                                <!-- DISCOUNT (ONLY IF EXISTS) -->

                                <t t-set="discount_total" t-value="order.compute_pos_discount_total()"/>

                                <t t-if="discount_total &gt; 0">
                                    <table style="width:100%; font-size:13px;">
                                        <tr>
                                            <td>Discounts</td>
                                            <td style="text-align:right;">
                                                $ <t t-esc="'{:,.2f}'.format(discount_total)"/>
                                            </td>
                                        </tr>
                                    </table>
                                </t>
                                <!-- QR -->
                                <table style="width:100%; margin-top:3px; border-collapse:collapse;">
                                    <tr style="vertical-align:top;">

                                        <!-- QR -->
                                        <td style="width:95px; position:relative; padding:0;">
                                            <img style="width:170px; height:170px; display:block; margin:0;"
                                                t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=200&amp;height=200' % (
                                                    (request.env['ir.config_parameter'].sudo().get_param('web.base.url') or '') 
                                                    + '/pos/ticket/validate?access_token=' 
                                                    + (order.access_token or '')
                                                )"/>
                                        </td>

                                        <!-- TEXT (Added padding-top here) -->
                                        <td style="padding-top:3mm; font-size:12px; vertical-align:top; padding-left:2px;">

                                            <div style="font-weight:600;">
                                                Need an invoice?
                                            </div>

                                            <div style="margin-top:2px; word-break:break-all;">
                                                <t t-esc="request.env['ir.config_parameter'].sudo().get_param('web.base.url') + '/pos/ticket'"/>
                                            </div>

                                            <div style="margin-top:2px;">
                                                Code: <t t-esc="order.ticket_code"/>
                                            </div>

                                        </td>

                                    </tr>
                                </table>
                                <!-- HSN -->
                                <t t-set="hsn_data" t-value="order.get_hsn_summary()"/>

                                <t t-if="hsn_data">
                                    <div style="text-align:center; font-weight:600; margin-top:2px;">
                                        HSN Summary
                                    </div>

                                    <table style="width:100%; margin-top:0px; border-collapse:collapse; font-size:13px;">

                                        <!-- HEADER -->
                                        <tr style="font-weight:600;">
                                            <td style="width:50%; text-align:center;">HSN Code</td>
                                            <td style="width:50%; text-align:center;">Rate%</td>
                                        </tr>

                                        <!-- DATA -->
                                        <t t-foreach="hsn_data.items()" t-as="item">
                                            <tr>
                                                <td style="text-align:center;">
                                                    <t t-esc="item[0]"/>
                                                </td>
                                                <td style="text-align:center;">
                                                    <t t-esc="item[1]['rate']"/>%
                                                </td>
                                            </tr>
                                        </t>

                                    </table>
                                </t>

                                <div style="border-top:1px dashed #ffffff; margin:8px 0;"></div>

                                <!-- FOOTER -->
                                <table style="width:100%; margin-top:3px; font-size:11px;">
                                    <tr>
                                    <td>
                                        <t t-esc="order.config_id.name"/><br/>

                                        <!-- FULL ADDRESS -->
                                        <t t-set="addr"
                                            t-value="', '.join(filter(None, [
                                                order.company_id.street,
                                                order.company_id.street2,
                                                order.company_id.city,
                                                (order.company_id.state_id.code if order.company_id.state_id else ''),
                                                order.company_id.zip
                                            ]))"/>

                                        <t t-esc="addr"/>
                                    </td>
                                    <td style="text-align:right;">
                                        Tel: <t t-esc="order.company_id.phone"/><br/>
                                        <t t-esc="order.company_id.email"/><br/>
                                        <t t-esc="order.company_id.website"/>
                                    </td>
                                    </tr>
                                </table>

                                <div style="text-align:center; margin-top:10px; font-size:11px;">
                                    Powered by <b>Odoo</b>
                                </div>

                            </div>
                        </div>
                    </t>
                </t>
            </t>
    </template>
</odoo>