<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="pos_order_receipt_backend">
    <t t-call="web.basic_layout">
      <t t-foreach="docs" t-as="order">

        <div style="width:260px; margin:auto; font-family:monospace; font-size:12px; line-height:1.2; color:#000;">

          <!-- HEADER -->
          <div style="text-align:center; margin-bottom:10px;">

            <img t-if="order.company_id.id"
                t-att-src="'/web/image/res.company/%s/logo' % order.company_id.id"
                style="max-height:55px; margin-bottom:6px;"/>

            <div style="font-size:10px;">
              Tax Invoice <t t-esc="order.pos_reference"/> INVOICE
            </div>

            <div style="font-size:10px; margin-top:3px;">
              <t t-esc="order.date_order.strftime('%d/%m/%Y, %I:%M %p')"/>
            </div>

            <div style="font-size:10px; color:#555;">
              Served by: <t t-esc="order.user_id.name"/>
            </div>

          </div>

          <div style="border-top:1px dashed #ffffff; margin:8px 0;"></div>

          <!-- PRODUCTS -->
          <t t-foreach="order.lines" t-as="line">
          <div style="margin-bottom:4px;">
            <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
              <tr>

                <td style="width:18px; font-weight:600;">
                  <t t-esc="int(line.qty)"/>
                </td>

                <td style="padding-left:6px;">
                  <div style="font-size:13px; line-height:1.2;">
                    <t t-esc="line.product_id.name"/>
                  </div>

                  <div style="font-size:10px; color:#666;">
                    $ <t t-esc="'{:,.2f}'.format(line.price_unit)"/> / Units
                  </div>
                </td>

                <td style="text-align:right; font-size:13px;">
                  $ <t t-esc="'{:,.2f}'.format(line.price_subtotal_incl)"/>
                </td>

              </tr>
            </table>
          </div>
          </t>

          <!-- TOTAL -->
          <table style="width:100%;">
            <tr>
              <td style="font-weight:700;">Total</td>
              <td style="text-align:right; font-weight:700;">
                $ <t t-esc="'{:,.2f}'.format(order.amount_total)"/>
              </td>
            </tr>
          </table>

          <!-- PAYMENTS -->
          <t t-foreach="order.payment_ids" t-as="p">
          <table style="width:100%;">
            <tr>
              <td><t t-esc="p.payment_method_id.name"/></td>
              <td style="text-align:right;">
                $ <t t-esc="'{:,.2f}'.format(p.amount)"/>
              </td>
            </tr>
          </table>
          </t>

          <!-- QR -->
          <table style="width:100%; margin-top:6px;">
          <tr style="vertical-align:top;">

            <td style="width:95px;">
              <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=90&amp;height=90' % (
                (request.env['ir.config_parameter'].sudo().get_param('web.base.url') or '') 
                + '/pos/ticket/validate?access_token=' 
                + (order.access_token or '')
              )"/>
            </td>

            <td style="padding-left:6px; font-size:11px; vertical-align:top;">

            <div style="margin-top:4px; font-weight:600;">
              Need an invoice?
            </div>

            <div style="margin-top:2px;">
              <t t-esc="request.env['ir.config_parameter'].sudo().get_param('web.base.url') + '/pos/ticket'"/>
            </div>

            <div style="margin-top:2px;">
              Code: <t t-esc="order.ticket_code"/>
            </div>

          </td>

          </tr>
          </table>

          <!-- HSN -->
          <div style="text-align:center; font-weight:600; margin-top:6px;">
            HSN Summary
          </div>

          <table style="width:100%; margin-top:4px; border-collapse:collapse; font-size:13px;">

            <!-- HEADER -->
            <tr style="font-weight:600;">
              <td style="width:50%; text-align:center; padding:2px 0;">
                HSN Code
              </td>
              <td style="width:50%; text-align:center; padding:2px 0;">
                Rate%
              </td>
            </tr>

            <!-- DATA -->
            <t t-set="hsn_map" t-value="{}"/>

              <t t-foreach="order.lines" t-as="line">
                  <t t-if="line.product_id.l10n_in_hsn_code">
                      <t t-set="hsn"
                        t-value="line.product_id.l10n_in_hsn_code"/>

                      <!-- add unique -->
                      <t t-if="not hsn_map.get(hsn)">
                          <t t-set="hsn_map"
                            t-value="dict(hsn_map, **{hsn: line})"/>
                      </t>
                  </t>
              </t>

              <!-- DISPLAY -->
              <t t-foreach="hsn_map.values()" t-as="line">
                  <tr>

                      <td style="text-align:center;">
                          <t t-esc="line.product_id.l10n_in_hsn_code"/>
                      </td>

                      <td style="text-align:center;">
                          <t t-if="line.tax_ids">
                              <t t-foreach="line.tax_ids" t-as="tax">
                                  <t t-esc="tax.amount"/>%
                              </t>
                          </t>
                          <t t-if="not line.tax_ids">0%</t>
                      </td>

                  </tr>
              </t>

          </table>

          <div style="border-top:1px dashed #ffffff; margin:8px 0;"></div>

          <!-- FOOTER -->
          <table style="width:100%; font-size:11px;">
            <tr>
              <td>
                <t t-esc="order.config_id.name"/><br/>
                <t t-esc="order.company_id.street"/><br/>
                <t t-esc="order.company_id.city"/>
              </td>
              <td style="text-align:right;">
                Tel: <t t-esc="order.company_id.phone"/><br/>
                <t t-esc="order.company_id.email"/><br/>
                <t t-esc="order.company_id.website"/>
              </td>
            </tr>
          </table>

          <div style="text-align:center; margin-top:10px; font-size:11px;">
            Powered by <b>Odoo</b>
          </div>

        </div>

      </t>
    </t>
  </template>
</odoo>