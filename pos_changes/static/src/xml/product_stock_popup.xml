<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_changes.ProductStockPopup">
        <Dialog title="props.title">
            <div class="product-stock-container p-3">
                <div class="mb-3">
                    <strong>Product: </strong> <span t-esc="props.productName"/>
                </div>
                <table class="table table-hover border">
                    <thead class="bg-100">
                        <tr>
                            <th class="p-2">Location Name</th>
                            <th class="p-2 text-center">Available Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="props.stockData and props.stockData.length > 0">
                            <t t-foreach="props.stockData" t-as="stock" t-key="stock.locationId">
                                <tr t-on-click="() => this.state.selectedLocId = stock.locationId"
                                    t-att-class="{'table-primary': state.selectedLocId === stock.locationId}"
                                    style="cursor: pointer;">
                                    <td class="p-2">
                                        <input type="radio" name="location" 
                                               t-att-checked="state.selectedLocId === stock.locationId" />
                                        <span class="ms-2" t-esc="stock.locationName"/>
                                    </td>
                                    <td class="p-2 text-center" t-esc="stock.stockQty"/>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="2" class="text-center p-3">No stock information available.</td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onAdd">Add to Order</button>
                <button class="btn btn-secondary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>

