<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_location_selector.LocationPopup">
        <Dialog title="'Select Location'">

            <div class="p-3">

                <t t-if="props.locations.length === 0">
                    <div>No Locations Found</div>
                </t>

                <t t-foreach="props.locations" t-as="loc" t-key="loc.id">
                    <div class="btn btn-light w-100 mb-2"
                         t-att-class="state.selected &amp;&amp; state.selected.id === loc.id ? 'btn-primary' : ''"
                         t-on-click="() => selectLocation(loc)">
                        <t t-esc="loc.complete_name"/>
                    </div>
                </t>

            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary"
                        t-on-click="confirm"
                        t-att-disabled="!state.selected">
                    Add
                </button>

                <button class="btn btn-secondary"
                        t-on-click="cancel">
                    Cancel
                </button>
            </t>

        </Dialog>
    </t>

</templates>