<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template
        id="index_sidebar_calendar"
        inherit_id="website_event.index_sidebar"
        active="True"
        name="Event Calendar Sidebar"
    >

        <xpath
            expr="//div[@id='o_wevent_index_sidebar']"
            position="inside"
        >

            <div class="o_wevent_sidebar_block event_studio_calendar_wrapper">

                <!-- TITLE -->
                <h6 class="o_wevent_sidebar_title">
                    Events Calendar
                </h6>

                <!-- CALENDAR -->
                <div class="event_calendar_main">

                    <!-- FLATPICKR -->
                    <div id="event_studio_calendar"></div>

                    <!-- EVENT POPUP -->
                    <div
                        id="event_calendar_popup"
                        class="event_calendar_popup event-popup-hidden"
                    ></div>

                </div>

                <!-- UPCOMING EVENTS -->
                <t t-if="is_view_active('event_studio.index_upcoming_events')">

                    <div class="event_upcoming">

                        <h6 class="o_wevent_sidebar_title">
                            Upcoming Events
                        </h6>

                        <!-- DYNAMIC EVENTS -->
                        <div
                            id="event_studio_upcoming_events"
                            class="event_upcoming_list_wrapper"
                        ></div>

                    </div>

                </t>

            </div>

        </xpath>

    </template>

    <!-- TOGGLE -->
    <template
        id="index_upcoming_events"
        name="Upcoming Events Toggle"
        active="True"
    />

</odoo>