<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t
        t-name="event_studio.EventsListPageOptionInherit"
        t-inherit="website_event.EventsListPageOption"
        t-inherit-mode="extension"
    >

        <!-- Quotes niche add -->
        <xpath expr="//BuilderRow[@label.translate='Quotes']" position="after">

            <!-- Calendar -->
            <BuilderRow label.translate="Calendar">
                <BuilderCheckbox
                    actionParam="{views: ['event_studio.index_sidebar_calendar']}"
                />
            </BuilderRow>

            <!-- Upcoming Events -->
            <BuilderRow label.translate="Upcoming Events">
                <BuilderCheckbox
                    actionParam="{views: ['event_studio.index_upcoming_events']}"
                />
            </BuilderRow>

        </xpath>

    </t>



    

</templates>